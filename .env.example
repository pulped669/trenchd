# Copy to .env.local and fill in what you have. Only ANTHROPIC_API_KEY is
# needed for ideas; pump.fun and DexScreener need no keys.

# ── Claude (idea generation + web news scan) ─────────────────────────────────
ANTHROPIC_API_KEY=
# RADAR_MODEL=claude-opus-5-5
# RADAR_EFFORT=high            # low | medium | high | xhigh | max

# ── Access ───────────────────────────────────────────────────────────────────
# Basic-auth password for /radar and /api/radar (any username). Required in
# production unless RADAR_PUBLIC=1, because every idea run spends API credits.
RADAR_PASSWORD=
# RADAR_PUBLIC=1

# ── Crypto Twitter (pick one; both optional) ─────────────────────────────────
# Official X API v2 bearer token (recent search + trends).
X_BEARER_TOKEN=
# Or twitterapi.io, a cheaper third-party read API.
TWITTERAPI_IO_KEY=
# Accounts to watch (comma-separated, no @). Defaults to a short CT list.
# X_ACCOUNTS=elonmusk,pumpdotfun,blknoiz06,notthreadguy,frankdegods,MustStopMurad
# Keyword queries, separated by "||".
# X_QUERIES=pump.fun OR pumpfun||memecoin OR memecoins
# X_TRENDS_WOEID=1             # 1 = worldwide, 23424977 = US
# X_MIN_FAVES=25               # twitterapi.io keyword searches only

# ── pump.fun / DexScreener ───────────────────────────────────────────────────
# PUMPFUN_API_BASE=https://frontend-api-v3.pump.fun
# PUMPFUN_NEWEST_LIMIT=150
# PUMPFUN_INCLUDE_NSFW=1
# PUMPFUN_DISABLED=1
# DEXSCREENER_CHAIN=solana
# DEXSCREENER_DISABLED=1
# RADAR_SNAPSHOT_TTL_SECONDS=45
